<div class="card mx-auto" style="max-width: 28rem">
  <% if @post.image.attached? %>
    <%= image_tag @post.image, class: "card-img-top", alt: @post.title %>
  <% end %>
  <div class="card-body">
    <h1 class="card-title"><%= @post.title %></h1>
    <p class="card-text"><%= @post.description %></p>
    <%= link_to "Back to posts", posts_path, class: "btn btn-secondary" %>
    <% if user_signed_in? && current_user == @post.user %>
      <%= link_to "Edit", edit_post_path(@post), class: "btn btn-primary" %>
      <%= button_to "Delete", @post, method: :delete, class: "btn btn-danger d-inline-block" %>
    <% end %>
  </div>
</div>
